###################################################################################
# DATABASE CONFIGURATION
###################################################################################

# Path to store the database files. Can be customized if needed.
DB_STORAGE_PATH=./postgres_data

# Password for the Postgres user. You should change this in production.
POSTGRES_PASSWORD=postgres

# ⚡ DO NOT CHANGE the variables below unless you know what you are doing
# Internal Postgres configuration - required by the application.
POSTGRES_USER=postgres
POSTGRES_DB=checktime
POSTGRES_DB_PORT=5432

ENCRYPTION_KEY=key_secret_encryption

###################################################################################
# APPLICATION VERSION
###################################################################################

# Version of CheckTime to use.
# Use "latest" to track the latest stable version, or set a specific version like "v1.0.0"
CHECK_TIME_VERSION=latest

###################################################################################
# WEB SERVER CONFIGURATION
###################################################################################

# Secret key for Flask sessions and security features.
# IMPORTANT: Replace with a strong random string in production!
FLASK_SECRET_KEY=local_dev_secret

# Flask environment mode: "development" enables debug mode; "production" disables it.
FLASK_ENV=production

# Admin password for accessing the application dashboard.
# ⚠️ Change this before deploying to production!
ADMIN_PASSWORD=admin

# Internal port the Flask application listens on inside the container.
# Usually 5000; you don't need to change this unless you know what you are doing.
PORT=5000

# External port exposed on the host/server for accessing the web application.
# Customize if you have port conflicts or multiple instances running.
WEB_PORT=5001

###################################################################################
# TELEGRAM BOT CONFIGURATION
###################################################################################

# Telegram bot token (you get this from BotFather).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID or group ID where the bot will send notifications.
TELEGRAM_CHAT_ID=your_chat_id_or_group_id_here

# The public name of your Telegram bot.
TELEGRAM_BOT_NAME=name_of_your_bot

###################################################################################
# SELENIUM CONFIGURATION
###################################################################################

# Maximum timeout (in seconds) for Selenium operations like login or navigation.
SELENIUM_TIMEOUT=30

###################################################################################
# SCHEDULER & CHECKJC ANTI-DETECTION
###################################################################################
# These knobs control how the scheduler talks to CheckJC. Defaults are tuned to
# look as much like a real user as possible after the InfoJC May 2026 lockout
# report flagged our previous deterministic timings + CDP field manipulation.

# Seconds to wait between consecutive users in the same scheduler batch.
# CheckJC's anti-bot rejects rapid sequential logins from the same egress IP
# (it serves a stripped "lite" HTML variant). Spacing logins out avoids it.
USER_CHECK_STAGGER_SECONDS=60

# Per-user random delay (0..X seconds) added AFTER the HH:MM trigger so the
# fichaje does NOT happen at exactly HH:MM:00 every day. InfoJC's IDS
# explicitly called out the always-09:00:XX cadence as a bot signal.
# Set to 0 to disable jitter.
CHECKJC_SCHEDULE_JITTER_SECONDS=30

# Human-think pause between a successful login and the actual fichaje click.
# Random value in [MIN, MAX] seconds. The pre-mitigation pattern was 1-2s
# every day, which was textbook bot — 20-90s feels like a real user landing
# and clicking. Lower both to 0 to disable.
CHECKJC_POST_LOGIN_JITTER_MIN_SECONDS=20
CHECKJC_POST_LOGIN_JITTER_MAX_SECONDS=90

# Per-keystroke random delay range (ms) when typing username/password.
# Triggers real keydown/keypress/keyup events that mimic human cadence,
# replacing the old CDP Input.insertText which fired no key events
# (and was flagged by InfoJC's IDS as "field manipulation").
CHECKJC_KEYSTROKE_DELAY_MIN_MS=60
CHECKJC_KEYSTROKE_DELAY_MAX_MS=180

# Extra retries when CheckJC serves the "lite" anti-bot HTML variant
# (body < ~20 KB instead of the normal ~70 KB). DEFAULT 0 — no retry.
# After the InfoJC May 2026 lockout, the operator chose zero retries to
# avoid ANY second /login hit. If the lite variant lands on the only
# attempt, that fichaje fails (next scheduled one tries fresh).
# Hard-capped to 1 retry total in code if you ever raise this.
CHECKJC_LITE_RETRIES=0

# Base seconds for the lite-variant retry wait if you raise the above.
# Actual wait = base * 2^(attempt-1) + 0-20s jitter. Irrelevant when
# CHECKJC_LITE_RETRIES=0.
CHECKJC_LITE_RETRY_SECONDS=60

# If true, the scheduler skips real CheckJC calls and pretends everything
# succeeded. Useful for local testing without touching production CheckJC.
SIMULATION_MODE=false

###################################################################################
# LOGGING CONFIGURATION
###################################################################################

# Logging level for the application: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Format for timestamps in logs.
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

###################################################################################
# SERVER TIMEZONE CONFIGURATION
###################################################################################

# Timezone of the server or container.
# List of valid timezones: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Europe/Madrid
